"""
Audio Data Ingestion Module

Handles audio file processing and transcription for sentiment analysis.
Uses speech-to-text models to convert audio to text.
"""

import os
import whisper
import pandas as pd
from datetime import datetime
import logging
from typing import List, Dict, Optional, Union
import librosa
import soundfile as sf

logger = logging.getLogger(__name__)


class AudioIngestion:
    """
    Audio ingestion class for processing audio files and transcribing them.
    
    Supports:
    - Various audio formats (wav, mp3, flac, m4a)
    - Whisper models for transcription
    - Batch processing of audio files
    """
    
    def __init__(self, config: Dict):
        """
        Initialize audio ingestion with configuration.
        
        Args:
            config: Audio configuration dictionary
        """
        self.config = config
        self.model = None
        self.input_dir = config.get('input_dir', 'audio_files')
        self.output_dir = config.get('output_dir', 'transcripts')
        self.model_size = config.get('model_size', 'base')
        self.file_format = config.get('file_format', 'wav')
        
        # Create directories if they don't exist
        os.makedirs(self.input_dir, exist_ok=True)
        os.makedirs(self.output_dir, exist_ok=True)
        
        # Load Whisper model
        self._load_model()
    
    def _load_model(self):
        """Load Whisper transcription model."""
        try:
            logger.info(f"Loading Whisper model: {self.model_size}")
            self.model = whisper.load_model(self.model_size)
            logger.info("Whisper model loaded successfully")
        except Exception as e:
            logger.error(f"Failed to load Whisper model: {e}")
            raise
    
    def get_audio_files(self) -> List[str]:
        """
        Get list of audio files in input directory.
        
        Returns:
            List of audio file paths
        """
        audio_files = []
        supported_formats = ['wav', 'mp3', 'flac', 'm4a', 'ogg', 'aac']
        
        try:
            for file in os.listdir(self.input_dir):
                file_path = os.path.join(self.input_dir, file)
                if os.path.isfile(file_path):
                    # Check file extension
                    file_ext = file.lower().split('.')[-1]
                    if file_ext in supported_formats:
                        audio_files.append(file_path)
            
            logger.info(f"Found {len(audio_files)} audio files in {self.input_dir}")
            
        except Exception as e:
            logger.error(f"Error scanning audio directory: {e}")
            raise
        
        return audio_files
    
    def transcribe_file(self, file_path: str) -> Dict:
        """
        Transcribe a single audio file.
        
        Args:
            file_path: Path to audio file
            
        Returns:
            Dictionary with transcription results
        """
        try:
            logger.info(f"Transcribing: {file_path}")
            
            # Load and transcribe audio
            result = self.model.transcribe(file_path)
            
            # Create transcription data
            transcription_data = {
                'file_path': file_path,
                'file_name': os.path.basename(file_path),
                'transcription': result['text'],
                'language': result.get('language', 'unknown'),
                'duration': self._get_audio_duration(file_path),
                'created_at': datetime.now(),
                'source': 'audio_transcription',
                'segments': result.get('segments', [])
            }
            
            logger.info(f"Transcription completed for {file_path}")
            
            return transcription_data
            
        except Exception as e:
            logger.error(f"Error transcribing {file_path}: {e}")
            raise
    
    def transcribe_batch(self, file_paths: List[str] = None) -> List[Dict]:
        """
        Transcribe multiple audio files.
        
        Args:
            file_paths: List of file paths (if None, uses all files in input_dir)
            
        Returns:
            List of transcription dictionaries
        """
        if file_paths is None:
            file_paths = self.get_audio_files()
        
        transcriptions = []
        
        for file_path in file_paths:
            try:
                transcription = self.transcribe_file(file_path)
                transcriptions.append(transcription)
            except Exception as e:
                logger.warning(f"Skipping {file_path} due to error: {e}")
                continue
        
        logger.info(f"Batch transcription completed: {len(transcriptions)} files processed")
        
        return transcriptions
    
    def _get_audio_duration(self, file_path: str) -> float:
        """
        Get duration of audio file in seconds.
        
        Args:
            file_path: Path to audio file
            
        Returns:
            Duration in seconds
        """
        try:
            duration = librosa.get_duration(path=file_path)
            return duration
        except Exception as e:
            logger.warning(f"Could not get duration for {file_path}: {e}")
            return 0.0
    
    def save_transcripts(self, transcriptions: List[Dict], format: str = 'txt') -> List[str]:
        """
        Save transcriptions to files.
        
        Args:
            transcriptions: List of transcription dictionaries
            format: Output format ('txt', 'json', 'csv')
            
        Returns:
            List of saved file paths
        """
        saved_files = []
        
        for transcription in transcriptions:
            try:
                file_name = transcription['file_name']
                base_name = os.path.splitext(file_name)[0]
                
                if format == 'txt':
                    output_path = os.path.join(self.output_dir, f"{base_name}_transcript.txt")
                    with open(output_path, 'w', encoding='utf-8') as f:
                        f.write(f"File: {file_name}\n")
                        f.write(f"Language: {transcription['language']}\n")
                        f.write(f"Duration: {transcription['duration']:.2f} seconds\n")
                        f.write(f"Transcription:\n{transcription['transcription']}\n")
                
                elif format == 'json':
                    import json
                    output_path = os.path.join(self.output_dir, f"{base_name}_transcript.json")
                    with open(output_path, 'w', encoding='utf-8') as f:
                        json.dump(transcription, f, indent=2, default=str)
                
                saved_files.append(output_path)
                
            except Exception as e:
                logger.error(f"Error saving transcript for {file_name}: {e}")
                continue
        
        logger.info(f"Saved {len(saved_files)} transcript files")
        
        return saved_files
    
    def process_audio_stream(self, audio_data: bytes, filename: str = None) -> Dict:
        """
        Process audio data from a stream (e.g., real-time audio).
        
        Args:
            audio_data: Raw audio data bytes
            filename: Optional filename for the audio
            
        Returns:
            Transcription dictionary
        """
        try:
            # Save temporary file
            if filename is None:
                filename = f"temp_audio_{datetime.now().strftime('%Y%m%d_%H%M%S')}.wav"
            
            temp_path = os.path.join(self.input_dir, filename)
            
            # Save audio data to temporary file
            with open(temp_path, 'wb') as f:
                f.write(audio_data)
            
            # Transcribe the temporary file
            transcription = self.transcribe_file(temp_path)
            
            # Clean up temporary file
            os.remove(temp_path)
            
            return transcription
            
        except Exception as e:
            logger.error(f"Error processing audio stream: {e}")
            raise
    
    def extract_segments(self, transcription: Dict) -> List[Dict]:
        """
        Extract individual segments from transcription with timestamps.
        
        Args:
            transcription: Transcription dictionary
            
        Returns:
            List of segment dictionaries
        """
        segments = []
        
        try:
            for i, segment in enumerate(transcription.get('segments', [])):
                segment_data = {
                    'segment_id': i,
                    'file_name': transcription['file_name'],
                    'text': segment['text'],
                    'start_time': segment['start'],
                    'end_time': segment['end'],
                    'duration': segment['end'] - segment['start'],
                    'confidence': segment.get('avg_logprob', 0.0)
                }
                segments.append(segment_data)
            
        except Exception as e:
            logger.error(f"Error extracting segments: {e}")
        
        return segments
    
    def to_dataframe(self, transcriptions: List[Dict]) -> pd.DataFrame:
        """
        Convert transcriptions to pandas DataFrame.
        
        Args:
            transcriptions: List of transcription dictionaries
            
        Returns:
            Pandas DataFrame with transcription data
        """
        if not transcriptions:
            return pd.DataFrame()
        
        df = pd.DataFrame(transcriptions)
        
        # Select relevant columns
        columns_to_keep = ['file_name', 'transcription', 'language', 'duration', 'created_at', 'source']
        df = df[[col for col in columns_to_keep if col in df.columns]]
        
        return df
    
    def get_audio_statistics(self, transcriptions: List[Dict]) -> Dict:
        """
        Get statistics about processed audio files.
        
        Args:
            transcriptions: List of transcription dictionaries
            
        Returns:
            Dictionary with audio statistics
        """
        if not transcriptions:
            return {}
        
        total_duration = sum(t['duration'] for t in transcriptions)
        avg_duration = total_duration / len(transcriptions)
        
        languages = {}
        for t in transcriptions:
            lang = t.get('language', 'unknown')
            languages[lang] = languages.get(lang, 0) + 1
        
        stats = {
            'total_files': len(transcriptions),
            'total_duration': total_duration,
            'average_duration': avg_duration,
            'languages': languages,
            'avg_transcription_length': sum(len(t['transcription']) for t in transcriptions) / len(transcriptions)
        }
        
        return stats
